"use client";

async function getItems() {
  try {
    const r = await fetch(`${process.env.NEXT_PUBLIC_SITE_URL ?? ""}/api/trust-network`, {
      cache: "no-store",
    });
    if (!r.ok) return [];
    const j = await r.json();
    return Array.isArray(j?.vendors) ? j.vendors : [];
  } catch {
    return [];
  }
}

export default async function TrustNetworkPage() {
  const items = await getItems();
  return (
    <main className="page">
      <h1 className="text-2xl font-semibold mb-4">Trust Network</h1>
      {items.length === 0 ? (
        <div className="text-sm text-zinc-500">No data available.</div>
      ) : (
        <ul className="list-disc pl-6">
          {items.map((v) => (
            <li key={v.id}>{v.name ?? "Vendor"}</li>
          ))}
        </ul>
      )}
    </main>
  );
}
