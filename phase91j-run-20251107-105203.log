PS C:\Users\MR.NELSON\Downloads\truvern> # Phase91m-ProdRollback.ps1
# Roll back production to a known-good deployment URL

$ErrorActionPreference = 'Stop'
Set-Location "C:\Users\MR.NELSON\Downloads\truvern"

$team = "nelson-addaes-projects"
$good = "https://truvern-6ct4bg5ip-nelson-addaes-projects.vercel.app"  # <- your working deployment
$stableProjectAlias = "truvern.vercel.app"   # project's stable alias
$customDomain = "truvern.com"                # if attached to the Vercel project

function Ok($msg){ Write-Host $msg -ForegroundColor Green }
function Info($msg){ Write-Host $msg -ForegroundColor Cyan }
function Warn($msg){ Write-Host $msg -ForegroundColor Yellow }
function Fail($msg){ Write-Host $msg -ForegroundColor Red; exit 1 }

# 0) Quick sanity: can we reach the working deployment?
Info "Probing working deployment..."
try {
  $h = Invoke-WebRequest -UseBasicParsing -Uri "$good/api/health" -TimeoutSec 20
  if ($h.StatusCode -ne 200) { Warn "Health returned $($h.StatusCode). Continuing anyway..." }
  Ok "OK: /api/health reachable"
} catch {
  Warn "Could not GET /api/health, trying root..."
  try {
    $r = Invoke-WebRequest -UseBasicParsing -Uri $good -TimeoutSec 20
    Ok "OK: root reachable ($($r.StatusCode))"
  } catch {
    Fail "The 'known-good' URL is not reachable right now. Aborting rollback."
  }
}

# 1) Prefer: promote this deployment to Production
Info "Promoting working deployment to Production (vercel promote)..."
$promote = cmd /c "vercel promote $good --scope $team --yes" 2>&1
Write-Host $promote

if ($promote -match 'Error' -or $LASTEXITCODE -ne 0) {
  Warn "vercel promote failed or not available. Falling back to alias set."
} else {
  Ok "Promoted successfully (or command accepted)."
}

# 2) Apply stable aliases to the working deployment (safe fallback)
Info "Pointing stable aliases to the working deployment..."

# Project stable alias
cmd /c "vercel alias set $good $stableProjectAlias --scope $team --yes" 2>&1 | Out-Null
Ok "Aliased $stableProjectAlias -> $good"

# Custom domain (if attached)
try {
  $domains = cmd /c "vercel domains ls --scope $team" 2>&1
  if ($domains -match $customDomain) {
    cmd /c "vercel alias set $good $customDomain --scope $team --yes" 2>&1 | Out-Null
    Ok "Aliased $customDomain -> $good"
  } else {
    Warn "$customDomain not attached to the project (skipping)."
  }
} catch { Warn "Could not check domains; skipping custom domain alias." }

# 3) Open pages to confirm
Info "Opening site to confirm..."
Start "$good"
Start "https://$stableProjectAlias"
Start "https://$customDomain"

Ok "Rollback complete. The stable aliases should now serve the working deployment."
Write-Host "Tip: Deploy new builds as PREVIEW first (omit --prod), verify, then run: vercel promote <preview-url> --scope $team --yes" -ForegroundColor Yellow

