generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vendor {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  riskScore  Int
}

model Assessment {
  id          Int      @id @default(autoincrement())
  vendorId    Int
  riskLevel   String
  createdAt   DateTime @default(now())
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
}
