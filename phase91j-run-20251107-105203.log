Write-Host "`nProduction URL:" -ForegroundColor Cyan;   Write-Host $prod -ForegroundColor Green
Write-Host "`nInspect URL:"    -ForegroundColor Yellow; Write-Host $inspect -ForegroundColor White

# 4) Quick probes (open in browser)
if ($prod) {
  Start "$prod/api/diag"
  Start "$prod/api/health"
  Start "$prod"
}

# 5) If the page still says “Something went wrong”, stream logs for that URL
if ($prod) {
  if (Test-Path $vc) { & $vc logs $prod --scope nelson-addaes-projects }
  else { npx vercel@latest logs $prod --scope nelson-addaes-projects }
}



