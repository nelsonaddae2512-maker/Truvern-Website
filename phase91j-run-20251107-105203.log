PS C:\Users\MR.NELSON\Downloads\truvern> # --- Get latest prod + inspect URLs from Vercel output (Windows-safe) ---

# 1) Point to the vercel shim if installed; else fall back to npx
$vcPath = Join-Path $env:APPDATA 'npm\vercel.cmd'
$useShim = Test-Path $vcPath

# 2) Run `vercel ls` and capture ALL stdout+stderr into one string (no throwing)
if ($useShim) {
  $out = & $vcPath ls truvern --scope nelson-addaes-projects 2>&1 | Out-String
} else {
  $out = npx vercel@latest ls truvern --scope nelson-addaes-projects 2>&1 | Out-String
}
Set-Content -Path raw.txt -Value $out -Encoding UTF8

# 3) Extract Production + Inspect URLs
$prodMatches    = [regex]::Matches($out,'https://truvern-[\w-]+\.vercel\.app')
$inspectMatches = [regex]::Matches($out,'https://vercel\.com/nelson-addaes-projects/truvern/\S+')

$prod    = if ($prodMatches.Count -gt 0) { $prodMatches[$prodMatches.Count - 1].Value } else { "" }
$inspect = if ($inspectMatches.Count -gt 0) { $inspectMatches[$inspectMatches.Count - 1].Value } else { "" }

Write-Host "`nProduction URL:" -ForegroundColor Cyan
if ($prod -ne "") { Write-Host $prod -ForegroundColor Green } else { Write-Host "(not found)" -ForegroundColor Red }

Write-Host "`nInspect URL:" -ForegroundColor Yellow
if ($inspect -ne "") { Write-Host $inspect -ForegroundColor White } else { Write-Host "(not found)" -ForegroundColor Red }

# 4) Probe basic health (opens browser tabs)
if ($prod -ne "") {
  Start "$prod/api/diag"
  Start "$prod/api/health"
  Start "$prod"
}

# 5) If site still shows the generic error, stream logs for that deployment URL
if ($prod -ne "") {
  if ($useShim) { & $vcPath logs $prod --scope nelson-addaes-projects }
  else { npx vercel@latest logs $prod --scope nelson-addaes-projects }
}

# 6) If parsing failed, show a peek of the captured output to debug
if ($prod -eq "" -or $inspect -eq "") {
  Write-Host "`n[peek] First 40 lines of raw.txt:" -ForegroundColor Magenta
  Get-Content raw.txt -TotalCount 40
}

