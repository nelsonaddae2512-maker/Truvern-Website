>> function Info($m){ Write-Host "[..]  $m" -ForegroundColor Cyan }
>> function Fail($m){ Write-Host "FATAL: $m" -ForegroundColor Red; Stop-Transcript; Read-Host "Press
ENTER"; exit 1 }
>>
>> # 0) Safety: ensure we're in project root
