>> # 4) Ensure Prisma Client is generated during CI (and locally)
>> if (-not (Test-Path ".\package.json")) { Fail "package.json not found" }
>> $pkg = Get-Content .\package.json -Raw | ConvertFrom-Json
>> if (-not $pkg.scripts) { $pkg | Add-Member -Name scripts -Value (@{}) -MemberType NoteProperty }
>> # prebuild and postinstall both call prisma generate (safe if ran twice)
>> $pkg.scripts.prebuild    = "prisma generate"
>> $pkg.scripts.postinstall = "prisma generate"
>> # ensure prisma is a dependency pair
