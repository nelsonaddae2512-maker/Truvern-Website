PS C:\Users\MR.NELSON\Downloads\truvern> # 1) Choose the safest way to call Vercel on Windows
$vc = Join-Path $env:APPDATA 'npm\vercel.cmd'
$cmd = if (Test-Path $vc) { "`"$vc`"" } else { "npx vercel@latest" }

# 2) Capture raw output without letting PowerShell throw on non-zero exit codes
cmd /c $cmd + " ls truvern --scope nelson-addaes-projects > raw.txt 2>&1"

# 3) Pull Production + Inspect URLs out of the text
