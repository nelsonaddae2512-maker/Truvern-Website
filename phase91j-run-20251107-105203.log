$ErrorActionPreference = 'Stop'
$root = "C:\Users\MR.NELSON\Downloads\truvern"
$pkgPath = Join-Path $root 'package.json'
Set-Location $root

Write-Host "`n=== Phase91k: package.json Repair (Final) ===" -ForegroundColor Cyan

if (-not (Test-Path $pkgPath)) {
    throw "❌ package.json not found at $pkgPath"
}

# Read and parse safely
$raw = Get-Content $pkgPath -Raw
try {
    $obj = $raw | ConvertFrom-Json
} catch {
    Write-Host "⚠️  Malformed package.json, rebuilding minimal version..." -ForegroundColor Yellow
    $obj = [ordered]@{
        name     = "truvern"
        version  = "1.0.0"
        scripts  = @{}
    }
}

# Force scripts to be a hash table, even if it’s a PSCustomObject
if (-not ($obj.PSObject.Properties.Name -contains 'scripts')) {
    $obj | Add-Member -NotePropertyName 'scripts' -NotePropertyValue @{}
}
if ($obj.scripts -isnot [hashtable]) {
    $temp = @{}
    foreach ($p in $obj.scripts.PSObject.Properties) { $temp[$p.Name] = $p.Value }
    $obj.scripts = $temp
}

# Patch the essential Prisma scripts
$obj.scripts['prebuild']    = 'prisma generate'
$obj.scripts['postinstall'] = 'prisma generate'

# Write JSON back safely (UTF-8 without BOM)
$utf8 = New-Object System.Text.UTF8Encoding($false)
$json = $obj | ConvertTo-Json -Depth 100
[System.IO.File]::WriteAllText($pkgPath, $json, $utf8)

Write-Host "✅ package.json repaired successfully!" -ForegroundColor Green
Write-Host "`nNext steps:" -ForegroundColor Yellow
