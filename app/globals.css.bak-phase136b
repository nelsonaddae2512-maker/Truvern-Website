@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --bg: #0b1220;
  --accent: #3b82f6;
  --text: #e2e8f0;
}

html, body {
  height: 100%;
  margin: 0;
  background: radial-gradient(circle at top, #0b1220 0%, #050814 100%);
  color: var(--text);
  font-family: "Inter", system-ui, sans-serif;
}

h1, h2, h3 {
  @apply font-semibold tracking-tight;
}

a {
  @apply text-blue-400 hover:text-blue-300 transition-colors;
}
