}

model Vendor {
  name        String       @unique
  riskScore   Int          @default(0)
  id          Int          @id @default(autoincrement())
  assessments Assessment[]
}

model Assessment {
  id        Int      @id @default(autoincrement())
  vendorId  Int
  riskLevel String
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
}
