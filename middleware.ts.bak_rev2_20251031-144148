import { NextResponse } from 'next/server';

const ASSET_RE = /\.(?:js|css|png|jpg|jpeg|gif|svg|webp|ico|ttf|woff|woff2)$/i;

export function middleware(req: Request) {
  const url = new URL(req.url);
  const res = NextResponse.next();
  setSecurityHeaders(res);

  if (url.pathname.startsWith('/api') || url.pathname.startsWith('/ops')) {
    // Dynamic data: never cache
    res.headers.set('Cache-Control', 'no-store');
    return res;
  }

  if (ASSET_RE.test(url.pathname)) {
    // Long-lived browser cache for fingerprinted assets
    res.headers.set('Cache-Control', 'public, max-age=31536000, immutable');
    return res;
  }

  // Default: allow CDN to cache briefly, browsers revalidate
  res.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=600');
  return res;
}

export const config = {
  matcher: '/:path*',
};
/* -- Injected by Phase18: security headers helper -- */
function setSecurityHeaders(res: Response) {
  const h = (res as any).headers as Headers;
  if (!h.get('Strict-Transport-Security')) h.set('Strict-Transport-Security', 'max-age=31536000; includeSubDomains; preload');
  if (!h.get('X-Frame-Options'))         h.set('X-Frame-Options', 'DENY');
  if (!h.get('Referrer-Policy'))         h.set('Referrer-Policy', 'no-referrer');
  if (!h.get('Permissions-Policy'))      h.set('Permissions-Policy', "camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)");
  // Start with report-only to avoid accidental breakages; switch to enforced CSP later.
  if (!h.get('Content-Security-Policy-Report-Only')) {
    h.set('Content-Security-Policy-Report-Only',
      "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; " +
      "img-src 'self' https: data: blob:; font-src 'self' data:; media-src 'self' https:; " +
      "style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://vitals.vercel-insights.com; " +
      "connect-src 'self' https://vitals.vercel-insights.com https://*.sentry.io; object-src 'none'; upgrade-insecure-requests");
  }
}
