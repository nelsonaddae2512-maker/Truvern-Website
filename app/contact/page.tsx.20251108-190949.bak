"use client";
import React from "react";

export default function ContactPage() {
  const [ok,setOk] = React.useState<boolean | null>(null);

  async function submit(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    const fd = new FormData(e.currentTarget);
    const body = Object.fromEntries(fd.entries());
    const r = await fetch("/api/contact", { method: "POST", body: JSON.stringify(body) });
    setOk(r.ok);
  }

  return (
    <div className="max-w-lg">
      <h1 className="text-2xl font-bold mb-3">Contact us</h1>
      <form onSubmit={submit} className="space-y-3">
        <input name="name" placeholder="Name" className="border rounded px-3 py-2 w-full" required />
        <input type="email" name="email" placeholder="Email" className="border rounded px-3 py-2 w-full" required />
        <textarea name="message" placeholder="Message" className="border rounded px-3 py-2 w-full" rows={4} required />
        <button className="px-4 py-2 rounded bg-blue-600 text-white">Send</button>
      </form>
      {ok === true  && <div className="text-green-700 mt-3">Thanks! We received your message.</div>}
      {ok === false && <div className="text-red-700 mt-3">Something went wrong.</div>}
    </div>
  );
}
