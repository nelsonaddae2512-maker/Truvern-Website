PS C:\Users\MR.NELSON\Downloads\truvern> # Phase91k-RepairJson.ps1
$ErrorActionPreference = 'Stop'
$root = "C:\Users\MR.NELSON\Downloads\truvern"
Set-Location $root
Write-Host "`n=== Phase91k JSON Repair ===" -ForegroundColor Cyan

# --- Function to safely rewrite JSON ---
function Fix-JsonFile($path) {
    Write-Host "Checking $path..." -ForegroundColor Yellow
    if (-not (Test-Path $path)) { Write-Host "   ❌ Not found"; return }
    try {
        $raw = Get-Content $path -Raw
        $null = $raw | ConvertFrom-Json
        Write-Host "   ✅ Already valid JSON" -ForegroundColor Green
    } catch {
        Write-Host "   ⚠️  Invalid JSON, rewriting..." -ForegroundColor Red
        $text = $raw.Trim()
        # Attempt basic cleanup (remove BOM, invisible chars)
        $text = $text -replace '^\uFEFF', ''
        try {
            $obj = $text | ConvertFrom-Json
        } catch {
            Write-Host "   ❌ Could not auto-fix; skipping" -ForegroundColor Red
            return
        }
        $utf8 = New-Object System.Text.UTF8Encoding($false)
        [System.IO.File]::WriteAllText($path, ($obj | ConvertTo-Json -Depth 100), $utf8)
        Write-Host "   ✅ Repaired and re-saved." -ForegroundColor Green
    }
}

# --- 1) Repair the main package.json ---
$pkg = Join-Path $root 'package.json'
if (Test-Path $pkg) {
    $raw = Get-Content $pkg -Raw
    try { $obj = $raw | ConvertFrom-Json } catch {
        Write-Host "   ⚠️  Repairing broken package.json..."
        $raw = $raw -replace '[^[:print:]\s]', ''
        $obj = @{ name='truvern'; version='1.0.0'; scripts=@{} }
    }
    if (-not ($obj.PSObject.Properties.Name -contains 'scripts')) {
        $obj | Add-Member -NotePropertyName scripts -NotePropertyValue (@{})
    }
    $obj.scripts['prebuild']    = 'prisma generate'
    $obj.scripts['postinstall'] = 'prisma generate'

    $utf8 = New-Object System.Text.UTF8Encoding($false)
    [System.IO.File]::WriteAllText($pkg, ($obj | ConvertTo-Json -Depth 100), $utf8)
    Write-Host "✅ package.json repaired." -ForegroundColor Green
}

# --- 2) Fix any other JSONs (like cli-48.7.1.json) ---
Get-ChildItem -Path $root -Filter *.json | ForEach-Object { Fix-JsonFile $_.FullName }

Write-Host "`n✅ JSON repair pass complete." -ForegroundColor Cyan
Write-Host "Next: run these commands manually:" -ForegroundColor Yellow
Write-Host "   pnpm install"
Write-Host "   pnpm prisma generate"
Write-Host "   pnpm run build"
Write-Host "Then deploy: vercel deploy --prod --yes --scope nelson-addaes-projects"


