>>   if (-not (Get-ChildItem Env: | Where-Object { $_.Name -eq $k })) { $missing += $k }
>> }
>> if($missing.Count -gt 0){
>>   Info "Local envs missing: $($missing -join ', ') - continuing; Vercel prod envs will be used."
>> }
>>
>> # 2) Force Node runtime in all app/api routes (remove Edge)
>> Info "Patching runtime to nodejs in all app/api/**/route.ts(x?) ."
>> $apiFiles = Get-ChildItem -Recurse -Filter "route.ts*" -Path ".\app\api" -ErrorAction SilentlyCont
inue
>> foreach($f in $apiFiles){
>>   $txt = Get-Content $f.FullName -Raw
>>   # replace existing edge declarations
>>   $txt = $txt -replace "export\s+const\s+runtime\s*=\s*['""]edge['""]\s*;?", "export const runtime
 = 'nodejs';"
>>   # if no runtime declared at all, optionally add one at the top (helps Vercel pick Node)
>>   if ($txt -notmatch "export\s+const\s+runtime\s*=\s*['""](nodejs|edge)['""]"){
>>     $txt = "export const runtime = 'nodejs';`r`n" + $txt
>>   }
>>   Set-Content -Path $f.FullName -Value $txt -Encoding UTF8
>> }
>> Ok "Runtime patched to Node.js"
>>
