import { NextResponse } from 'next/server';

/* Enhanced by Phase18-Rev2 — enforce headers on every route */
function setSecurityHeaders(res: Response) {
  const h = (res as any).headers as Headers;
  h.set('Strict-Transport-Security', 'max-age=31536000; includeSubDomains; preload');
  h.set('X-Frame-Options', 'DENY');
  h.set('Referrer-Policy', 'no-referrer');
  h.set('Permissions-Policy', "camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)");
  h.set('Content-Security-Policy-Report-Only',
    "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; " +
    "img-src 'self' https: data: blob:; font-src 'self' data:; media-src 'self' https:; " +
    "style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://vitals.vercel-insights.com; " +
    "connect-src 'self' https://vitals.vercel-insights.com https://*.sentry.io; object-src 'none'; upgrade-insecure-requests");
}

export function middleware(req: Request) {
  const url = new URL(req.url);
  const res = NextResponse.next({ request: { headers: req.headers } });
  setSecurityHeaders(res);
  return res;
}

export const config = {
  matcher: [
    '/((?!_next/static|_next/image|favicon.ico|robots.txt).*)',
  ],
};