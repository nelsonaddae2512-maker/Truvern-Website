PS C:\Users\MR.NELSON\Downloads\truvern> # Phase91j2-FullFix-PS.ps1
# No -Raw usage. Uses .NET file IO. Same goals: force Node runtime, add diag/health,
# ensure Prisma client is generated in CI, clean build, deploy to Vercel (non-prebuilt).

$ErrorActionPreference = 'Stop'
$host.UI.RawUI.WindowTitle = "Phase91j2 - Full Fix & Deploy (PS-compatible)"
$log = ".\phase91j2-run-$(Get-Date -Format yyyyMMdd-HHmmss).log"
Start-Transcript -Path $log -Force | Out-Null

function Ok($m){ Write-Host "[OK]  $m" -ForegroundColor Green }
function Info($m){ Write-Host "[..]  $m" -ForegroundColor Cyan }
function Fail($m){ Write-Host "FATAL: $m" -ForegroundColor Red; Stop-Transcript; Read-Host "Press ENTER"; exit 1 }

# 0) Ensure we’re in the project root
$root = "C:\Users\MR.NELSON\Downloads\truvern"
if (-not (Test-Path $root)) { Fail "Project root not found at $root" }
Set-Location $root

# 1) (Optional) show missing local envs; Vercel will use prod envs anyway
$req = @('DATABASE_URL','NEXT_PUBLIC_APP_URL')
$missing = @()
foreach($k in $req){ if (-not (Get-ChildItem Env: | Where-Object { $_.Name -eq $k })) { $missing += $k } }
if($missing.Count -gt 0){ Info "Local envs missing: $($missing -join ', '). Continuing; cloud build will use Vercel envs." }

# 2) Force Node.js runtime in every app/api/**/route.ts(x?)
Info "Patching runtime to 'nodejs' in app/api/**/route.ts* …"
$apiFiles = Get-ChildItem -Recurse -Filter "route.ts*" -Path ".\app\api" -ErrorAction SilentlyContinue
foreach($f in $apiFiles){
  $txt = [System.IO.File]::ReadAllText($f.FullName)

  # Replace existing 'edge'
  $txt = [System.Text.RegularExpressions.Regex]::Replace(
    $txt,
    "export\s+const\s+runtime\s*=\s*['""]edge['""]\s*;?",
    "export const runtime = 'nodejs';",
    [System.Text.RegularExpressions.RegexOptions]::IgnoreCase
  )

  # If no runtime at all, prepend one
  if ($txt -notmatch "export\s+const\s+runtime\s*=\s*['""](nodejs|edge)['""]"){
    $txt = "export const runtime = 'nodejs';`r`n" + $txt
  }

  [System.IO.File]::WriteAllText($f.FullName, $txt, [System.Text.UTF8Encoding]::new($true))
}
Ok "Runtime set to Node.js"

# 3) Add /api/diag and /api/health endpoints
New-Item -Force -ItemType Directory -Path ".\app\api\diag"   | Out-Null
New-Item -Force -ItemType Directory -Path ".\app\api\health" | Out-Null

$diag = @"
export const runtime = 'nodejs';
export async function GET() {
  return new Response(JSON.stringify({ ok: true, ts: Date.now() }), {
    status: 200,
    headers: { 'content-type': 'application/json' }
  });
}
"@
[System.IO.File]::WriteAllText(".\app\api\diag\route.ts", $diag, [System.Text.UTF8Encoding]::new($true))

$health = @"
export const runtime = 'nodejs';
export async function GET() { return new Response('ok', { status: 200 }); }
"@
[System.IO.File]::WriteAllText(".\app\api\health\route.ts", $health, [System.Text.UTF8Encoding]::new($true))
Ok "Health endpoints created"

# 4) Ensure Prisma client generation happens in CI (and locally)
if (-not (Test-Path ".\package.json")) { Fail "package.json not found" }
$pkgText = [System.IO.File]::ReadAllText(".\package.json")
$pkg = $pkgText | ConvertFrom-Json
if (-not $pkg.scripts) { $pkg | Add-Member -Name scripts -Value (@{}) -MemberType NoteProperty }
$pkg.scripts.prebuild    = "prisma generate"
$pkg.scripts.postinstall = "prisma generate"
([string]($pkg | ConvertTo-Json -Depth 100)) | Set-Content ".\package.json" -Encoding UTF8
Ok "package.json scripts updated (prebuild/postinstall -> prisma generate)"

# 5) Clean prior build outputs
Info "Cleaning .next, .turbo and .vercel/output…"
Remove-Item -Recurse -Force ".\.next" -ErrorAction SilentlyContinue
Remove-Item -Recurse -Force ".\.turbo" -ErrorAction SilentlyContinue
Remove-Item -Recurse -Force ".\ .vercel\output" -ErrorAction SilentlyContinue  # space guards path typo
Remove-Item -Recurse -Force ".\vercel\output"  -ErrorAction SilentlyContinue
Remove-Item -Recurse -Force ".\.vercel\output" -ErrorAction SilentlyContinue

# 6) Install deps, allow native builds, generate Prisma
Info "Installing deps…"
pnpm install
try { pnpm approve-builds --global --all | Out-Null } catch {}
pnpm prisma generate

# 7) Local build (catch errors early)
Info "Building locally…"
pnpm run build

# 8) Deploy normally to Vercel (no --prebuilt)
$team = "nelson-addaes-projects"
Info "Deploying to Vercel production…"
vercel deploy --prod --yes --scope $team

Write-Host ""
Write-Host "Open the printed Production URL, then check:" -ForegroundColor Yellow
Write-Host "  • /api/diag    -> JSON with ok:true"
Write-Host "  • /api/health  -> 'ok'"
Ok "Done. Log: $log"
Stop-Transcript | Out-Null
Read-Host "Press ENTER to close"

